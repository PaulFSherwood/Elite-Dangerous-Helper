QWidget {
    background-color: #0B1117;
    color: #E6EDF3;
    font-size: 13px;
}

/* Runtime activity feedback -------------------------------------------------
   A subtle warm/red tint tells the user that Observatory is applying fresh
   Journal/Cargo/Market data.  It is deliberately darker than an error state. */
QWidget#fullContent[updating="true"] {
    background-color: #28151A;
}

QFrame#thinCard[updating="true"] {
    background-color: #28151A;
    border-color: #7A3A42;
}

QFrame#startupOverlay {
    background-color: rgba(24, 12, 16, 248);
    border: 2px solid #7A3A42;
    border-radius: 12px;
}

QLabel#startupTitle {
    color: #F8D7DA;
    background-color: transparent;
    font-size: 24px;
    font-weight: bold;
    padding: 8px;
}

QLabel#startupMessage {
    color: #E6EDF3;
    background-color: transparent;
    font-size: 15px;
    padding: 8px;
}



QLabel {
    background-color: transparent;
    color: #E6EDF3;
    font-size: 14px;
    padding: 2px;
}

QComboBox#searchCombo {
    background-color: #0B1117;
    color: #E6EDF3;
    border: 1px solid #2A3A48;
    border-radius: 8px;
    padding: 6px 10px;
    min-width: 130px;
}

QComboBox#searchCombo:hover {
    border: 1px solid #4B6B88;
}

QComboBox#searchCombo:disabled {
    color: #6B7280;
}

QComboBox#searchCombo QAbstractItemView {
    background-color: #0B1117;
    color: #E6EDF3;
    border: 1px solid #2A3A48;
    selection-background-color: #17324A;
    selection-color: #FFFFFF;
}

QLabel#specialText {
    background-color: transparent;
    color: #9FB0BF;
    font-size: 14px;
    font-weight: bold;
}

QLabel#specialIcon {
    background-color: transparent;
    color: #64748B;
    font-size: 20px;
    font-weight: bold;
}

QLabel#specialIcon[alert="true"] {
    background-color: transparent;
    color: #FFD700;
    font-size: 20px;
    font-weight: bold;
}

QLabel#searchRulesLabel {
    background-color: transparent;
    color: #C7D0D9;
    font-size: 12px;
    padding: 0px;
}

QLabel#searchCardTitle {
    background-color: transparent;
    color: #C7D0D9;
    font-size: 13px;
    padding: 2px 4px;
}

QLabel#searchSelectIcon {
    background-color: rgba(23, 50, 74, 180);
    color: #60A5FA;
    border: 1px solid #2A3A48;
    border-radius: 8px;
    min-width: 24px;
    min-height: 24px;
    font-size: 14px;
    font-weight: bold;
    padding: 2px;
}

QFrame#routeSeparator {
    background-color: #2A3A48;
    border: none;
    margin-top: 12px;
    margin-bottom: 12px;
}

QLabel#footerLabel {
    background-color: transparent;
    color: #9FB0BF;
    font-size: 12px;
    padding: 4px 8px;
}

QLabel#legendLabel {
    background-color: transparent;
    color: #C7D0D9;
    font-size: 12px;
    padding: 4px;
}

QLabel#sectionTitle {
    background-color: transparent;
    color: #E6EDF3;
    font-size: 12px;
    font-weight: bold;
    padding: 0px;
    margin: 0px;
}

QLabel#tableTitle {
    background-color: transparent;
    color: #E6EDF3;
    font-size: 13px;
    font-weight: bold;
    padding: 2px 6px;
}

QLabel#cardIcon {
    background-color: transparent;
    color: #F59E0B;
    font-size: 20px;
    font-weight: bold;
    padding: 0px;
}

QLabel#cardTitle {
    background-color: transparent;
    color: #9FB0BF;
    font-size: 12px;
}

QLabel#cardValue {
    background-color: transparent;
    color: #E6EDF3;
    font-size: 15px;
    font-weight: bold;
}

QFrame#infoCard {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}

QFrame#wideCard,
QFrame#commanderStatsCard,
QFrame#searchSelectCard,
QFrame#searchRulesCard {
    background-color: rgba(18, 28, 38, 230);
    border: 1px solid #2A3A48;
    border-radius: 12px;
}

QFrame#searchRulesCard[confirmed="true"] {
    background-color: rgba(10, 55, 34, 210);
    border: 1px solid #1F9D55;
}

QFrame#specialCard {
    background-color: rgba(9, 15, 22, 160);
    border: 1px solid #243342;
    border-radius: 12px;
}

QFrame#specialCard[alert="true"] {
    background-color: #4A102A;
    border: 1px solid #8A3A5A;
    border-radius: 12px;
}

QFrame#specialMessageCard {
    background-color: rgba(11, 17, 23, 170);
    border: 1px solid #243342;
    border-radius: 12px;
}

QFrame#tableCard {
    background-color: rgba(17, 26, 34, 230);
    border: 1px solid #2A3A48;
    border-radius: 12px;
}

QFrame#bottomCard {
    background-color: rgba(22, 32, 42, 220);
    border: 1px solid #2A3A48;
    border-radius: 12px;
}

QLabel#commanderStatChip {
    background-color: rgba(11, 17, 23, 210);
    color: #E6EDF3;
    border: 1px solid #213142;
    border-radius: 8px;
    padding: 0px 0px;
    font-size: 11px;
}

QPushButton#opacityButton {
    background-color: #1E2B36;
    color: #F59E0B;
    border: 1px solid #3A4A58;
    border-radius: 14px;
    font-size: 12px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#opacityButton:hover {
    background-color: #2A3A48;
}

QPushButton#tableFilterButton {
    background-color: #0B1117;
    color: #C7D0D9;
    border: 1px solid #2A3A48;
    border-radius: 8px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton#tableFilterButton:hover {
    border: 1px solid #4B6B88;
    color: #FFFFFF;
}

QPushButton#tableFilterButton[active="true"] {
    background-color: #17324A;
    color: #FFFFFF;
    border: 1px solid #60A5FA;
}

QTableWidget {
    background-color: #111A22;
    alternate-background-color: #13202A;
    color: #E6EDF3;
    gridline-color: #243342;
    selection-background-color: #27445C;
    border: none;
    border-radius: 12px;
}

QTableWidget::viewport {
    background-color: #111A22;
    border-radius: 8px;
}

QTableWidget::item {
    padding: 3px;
}

QHeaderView::section {
    background-color: #1E2B36;
    color: #DCE6EE;
    padding: 6px;
    border: none;
    border-right: 1px solid #2A3A48;
}

QTableCornerButton::section {
    background-color: #1E2B36;
    border: none;
    border-top-left-radius: 8px;
}

QTextEdit {
    background-color: #0B1117;
    color: #A7FF83;
    border: 1px solid #2A3A48;
    border-radius: 10px;
    padding: 6px;
}

QFrame#thinCard {
    background-color: rgba(12, 20, 28, 245);
    border: 1px solid #2A3A48;
    border-radius: 8px;
}

QLabel#thinSystem {
    color: #E6EDF3;
    font-size: 13px;
    font-weight: bold;
    padding: 0px 4px;
}

QLabel#thinStatus {
    color: #C7D0D9;
    font-size: 13px;
    padding: 0px 4px;
}

QPushButton#modeToggleButton {
    background-color: #17232D;
    color: #9FB0BF;
    border: 1px solid #344554;
    border-radius: 6px;
    font-size: 14px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#modeToggleButton:hover {
    background-color: #253746;
    color: #FFFFFF;
}

/* Construction mode ----------------------------------------------------- */
QTabWidget#constructionTabs::pane {
    border: 1px solid #263A4A;
    border-radius: 8px;
    background: #0C1720;
}
QTabWidget#constructionTabs QTabBar::tab {
    background: #101D27;
    color: #D7E2EA;
    border: 1px solid #263A4A;
    padding: 7px 18px;
    min-width: 105px;
}
QTabWidget#constructionTabs QTabBar::tab:selected {
    color: #60A5FA;
    border-bottom: 2px solid #60A5FA;
    background: #132433;
}
QFrame#constructionBox {
    background: #0A141C;
    border: 1px solid #263A4A;
    border-radius: 9px;
}
QLabel#constructionHeading {
    color: #60A5FA;
    font-weight: 700;
    font-size: 13px;
}
QLabel#constructionBigValue {
    color: #F59E0B;
    font-weight: 700;
    font-size: 15px;
}
QLabel#constructionLock, QLabel#constructionNotice {
    color: #9FB0BF;
}
QPushButton#constructionEditButton {
    color: #F59E0B;
    border: 1px solid #8A6300;
}

QPushButton#systemLockButton {
    background-color: #493710;
    color: #F59E0B;
    border: 1px solid #8A6300;
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: bold;
    min-width: 105px;
}

QPushButton#systemLockButton:hover {
    background-color: #5A4615;
    color: #FFFFFF;
}

QPushButton#systemLockButton[locked="true"] {
    background-color: #4C1D95;
    color: #FFFFFF;
    border: 1px solid #8B5CF6;
}
QProgressBar {
    border: 1px solid #263A4A;
    border-radius: 5px;
    background: #071019;
    text-align: center;
}
QProgressBar::chunk {
    background: #F59E0B;
    border-radius: 4px;
}

/* Child containers used to swap Exploration and Construction content must
   remain transparent so the existing rounded cards keep their background. */
QStackedWidget,
QStackedWidget > QWidget,
QWidget#constructionGoalWidget,
QWidget#explorationSearchWidget {
    background-color: transparent;
    border: none;
}

QLabel#modeSelectorIcon {
    background-color: transparent;
    color: #F59E0B;
    font-size: 20px;
}

QLabel#modeSelectorLabel {
    background-color: transparent;
    color: #9FB0BF;
    font-size: 12px;
}

/* Construction workflow v3 --------------------------------------------- */
QPushButton#systemLockButton {
    min-width: 145px;
}

QLabel#constructionMuted {
    color: #9FB0BF;
}

QLabel#constructionStatusPill {
    background-color: #17232D;
    color: #9FB0BF;
    border: 1px solid #344554;
    border-radius: 6px;
    padding: 4px 8px;
    font-weight: 600;
}

QLabel#materialSourcePill {
    background-color: #27313D;
    color: #E6EDF3;
    border: 1px solid #465565;
    border-radius: 7px;
    padding: 5px 9px;
    font-weight: 700;
}

QLabel#materialSourcePill[sourceKind="local"] {
    background-color: #211A2E;
    color: #D8B4FE;
    border-color: #A855F7;
}

QLabel#materialSourcePill[sourceKind="external"] {
    background-color: #123047;
    color: #BAE6FD;
    border-color: #3B82A0;
}

QLabel#materialSourcePill[sourceKind="none"] {
    background-color: #18232D;
    color: #8E9AA6;
    border-color: #344452;
}

QFrame#nextHaulCard {
    background-color: #101D27;
    border: 1px solid #5B3B05;
    border-radius: 8px;
}

QLabel#nextHaulTitle {
    color: #F59E0B;
    font-weight: 800;
    font-size: 14px;
}

QLabel#materialSourcePill[missing="true"] {
    background-color: #493710;
    color: #F59E0B;
    border: 1px solid #8A6300;
}

/* Construction planner v3.0.7 ----------------------------------------- */
QPushButton#constructionPrimaryAction {
    background-color: #17324A;
    color: #EAF4FF;
    border: 1px solid #3B6B8F;
    border-radius: 6px;
    padding: 5px 10px;
    font-weight: 700;
}
QPushButton#constructionPrimaryAction:hover {
    background-color: #20425E;
    border-color: #60A5FA;
}
QLabel#constructionGoalStatus {
    color: #9FB0BF;
    font-size: 11px;
    padding: 0 2px 2px 2px;
}
QLabel#constructionPhaseStatus {
    background-color: #102131;
    color: #60A5FA;
    border: 1px solid #263A4A;
    border-radius: 6px;
    padding: 4px 8px;
    font-weight: 700;
}

/* Construction planner v3.0.8 ----------------------------------------- */
QLabel#constructionGoalSummary {
    color: #D9E6EF;
    background-color: #0F1B24;
    border: 1px solid #263A4A;
    border-radius: 6px;
    padding: 5px 8px;
}

/* Construction planner migration fix v3.1.0 ------------------------- */
QLabel#constructionLock[editing="true"] {
    color: #F59E0B;
    font-weight: 700;
    padding: 2px 6px;
    border: 1px solid #8A6300;
    border-radius: 5px;
    background-color: #2A210B;
}


/* Construction usability pass v3.1.0 ---------------------------------- */
QLabel#constructionWorkflowHint {
    color: #7F95A6;
    font-size: 11px;
    padding: 2px 1px;
}

QPushButton#constructionSecondaryAction {
    text-align: left;
    color: #9FB0BF;
    background-color: #101A22;
    border: 1px solid #263A4A;
    border-radius: 5px;
    padding: 4px 8px;
}
QPushButton#constructionSecondaryAction:hover {
    color: #D9E6EF;
    border-color: #3B6B8F;
}
